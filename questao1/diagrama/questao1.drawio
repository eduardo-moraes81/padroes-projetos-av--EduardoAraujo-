="registro" value="&lt;&lt;Registro imutável&gt;&gt;&lt;br&gt;&lt;b&gt;RegistroAuditoria&lt;/b&gt;&lt;br&gt;Data/hora, ambiente, provedor e resultado/motivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6573;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="340" width="280" height="100" as="geometry" /></mxCell><mxCell id="recurso" value="&lt;&lt;Interface de recurso&gt;&gt;&lt;br&gt;&lt;b&gt;RecursoNuvem&lt;/b&gt;&lt;br&gt;A composição do ambiente contém apenas recursos do mesmo provedor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#5b6573;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="850" y="590" width="380" height="100" as="geometry" /></mxCell><mxCell id="fabrica-interface-operacional" value="&lt;&lt;Fábrica abstrata&gt;&gt;&lt;br&gt;&lt;b&gt;FabricaRecursosNuvem&lt;/b&gt;&lt;br&gt;Contrato recebido pelo provisionador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#5b6573;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="300" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>